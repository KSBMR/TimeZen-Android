<?xml version="1.0" encoding="utf-8"?>
<!-- Original TimeZen mark: a progress ring with a small center dot. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ring track -->
    <path
        android:fillColor="#00000000"
        android:pathData="M32,54a22,22 0 1,0 44,0a22,22 0 1,0 -44,0"
        android:strokeColor="#2A353A"
        android:strokeWidth="9" />

    <!-- Progress arc (about 270 degrees, starting at the top) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,32A22,22 0 1,1 32,54"
        android:strokeColor="#35C9D8"
        android:strokeLineCap="round"
        android:strokeWidth="9" />

    <!-- Center dot -->
    <path
        android:fillColor="#67D391"
        android:pathData="M49,54a5,5 0 1,0 10,0a5,5 0 1,0 -10,0" />
</vector>
